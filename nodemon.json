{
  "watch": [
    "server.js",
    "routes",
    "controllers",
    "models",
    "queue",
    "services",
    "middleware",
    "utils"
  ],
  "ext": "js,json",
  "ignore": [
    "test-frontend",
    "test-frontend/**",
    "uploads",
    "uploads/**",
    "datasets",
    "datasets/**",
    "models/*/**",
    "results",
    "results/**",
    "workers",
    "workers/**",
    "node_modules",
    ".git",
    "*.log"
  ],
  "delay": "250",
  "legacyWatch": false
}

